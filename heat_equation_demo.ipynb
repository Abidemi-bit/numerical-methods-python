   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = np.linspace(0, 1, 50)\n",
    "u = np.sin(np.pi * x)\n",
    "\n",
    "plt.plot(x, u)\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"u(x)\")\n",
    "plt.title(\"Test Plot\")\n",
    "plt.show()"
   ]
